-
  const returnTopImg = img => img !== false ? img || theme.default_top_img : false
  const isFixedClass = theme.nav.fixed ? ' fixed' : ''
  // Personal homepage hero, configured under `home_hero` in _config.butterfly.yml
  const homeHero = theme.home_hero || {}
  const homeHeroBgs = homeHero.enable && Array.isArray(homeHero.backgrounds)
    ? homeHero.backgrounds.filter(Boolean)
    : []
  var top_img = false
  let headerClassName = 'not-top-img'
  var bg_img = ''

if !theme.disable_top_img && page.top_img !== false
  case globalPageType
    when 'post'
      //- A post only gets a banner when it actually has a cover, so the header
      //- never shows the theme's flat colour band. Without one, post-info is
      //- rendered at the top of the article instead (see layout/post.pug).
      - top_img = page.top_img || page.cover || false
    when 'page'
      - top_img = page.top_img || theme.default_top_img
    when 'tag'
      - top_img = theme.tag_per_img && theme.tag_per_img[page.tag] || returnTopImg(theme.tag_img)
    when 'category'
      - top_img = theme.category_per_img && theme.category_per_img[page.category] || returnTopImg(theme.category_img)
    when 'home'
      - top_img = homeHeroBgs.length ? homeHeroBgs[0] : returnTopImg(theme.index_img)
    when 'archive'
      - top_img = returnTopImg(theme.archive_img)
    default
      - top_img = page.top_img || theme.default_top_img

  if top_img !== false
    - bg_img = getBgPath(top_img)
    - headerClassName = globalPageType === 'home' ? 'full_page' : globalPageType === 'post' ? 'post-bg' : 'not-home-page'

header#page-header(class=`${headerClassName + isFixedClass}` style=bg_img)
  include ./nav.pug
  if top_img !== false
    if globalPageType === 'post'
      include ./post-info.pug
    else if globalPageType === 'home'
      if homeHero.enable
        #home-hero(data-interval=homeHero.interval || 7)
          #home-hero-slides
            each img, i in homeHeroBgs
              .home-hero-slide(class=i === 0 ? 'is-active' : '' style=getBgPath(img))
          #home-hero-inner
            if homeHero.avatar
              #home-hero-avatar
                img.no-lightbox(src=homeHero.avatar alt=homeHero.name || '' loading='eager')
            if homeHero.name
              #home-hero-id
                h1#home-hero-name= homeHero.name
                if homeHero.birthday
                  span#home-hero-birthday(title='生日')
                    i.fas.fa-cake-candles
                    span= homeHero.birthday
            if homeHero.subtitle
              p#home-hero-subtitle= homeHero.subtitle
            if homeHero.links && homeHero.links.length
              nav#home-hero-links
                each link in homeHero.links
                  - const isExternal = /^https?:\/\//.test(link.url || '')
                  a.home-hero-link(href=url_for(link.url) target=isExternal ? '_blank' : false rel=isExternal ? 'noopener' : false title=link.name aria-label=link.name)
                    if link.icon
                      i(class=link.icon)
                    span.home-hero-link-label= link.name
      else
        #site-info
          h1#site-title=config.title
          if theme.subtitle.enable
            - var loadSubJs = true
            #site-subtitle
              span#subtitle
          if theme.social
            #site_social_icons
              !=partial('includes/header/social', {}, {cache: true})
      #scroll-down
        i.fas.fa-angle-down.scroll-down-effects
    else
      #page-site-info
        h1#site-title=page.title || page.tag || page.category
  else
    //- improve seo
    if globalPageType !== 'post'
      h1.title-seo=page.title || page.tag || page.category || config.title