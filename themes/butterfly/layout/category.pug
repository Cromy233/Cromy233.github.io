extends includes/layout.pug

include ./includes/mixins/home-card.pug

//- A single category's post list. Renders the same cards as the 文章 page so
//- the two match; there is deliberately no timeline variant here.

block content
  #article-container.home-feed
    if !page.posts || !page.posts.length
      .home-feed-empty
        p 这个分类下还没有文章。

    each post in page.posts.toArray()
      +postCard(post)